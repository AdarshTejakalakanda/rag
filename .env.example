# ==============================================================================
# Local Agentic RAG Test Coverage Analyzer - Environment Configuration
# ==============================================================================

# LLM Provider Selection: gemini | openai | anthropic | ollama | mock
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Recommended)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Alternative models: gemini-2.0-flash, gemini-1.5-pro

# ------------------------------------------------------------------------------
# 2. OpenAI API / Compatible Endpoints (Azure, DeepSeek, Groq, OpenRouter, vLLM)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Custom Base URL (Optional - for Azure, DeepSeek, Groq, LMStudio, vLLM, LiteLLM):
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 3. Anthropic Claude API
# ------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 4. Ollama (100% Local / Airgapped)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 5. Local Models & Hardware Acceleration (CPU / CUDA / MPS)
# ------------------------------------------------------------------------------
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# Optional Hugging Face Token (for faster model downloads)
# HF_TOKEN=your_hf_token_here
